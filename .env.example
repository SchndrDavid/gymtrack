# Host port the app is published on
GYMTRACK_PORT=8101

# User the container runs as — must own ./data
GYMTRACK_UID=1000
GYMTRACK_GID=1000

# ─── Food ───────────────────────────────────────────────────────────────────
# MordorCook base URL for "Sync recipes", e.g. http://100.108.145.60:8105
# Leave empty to hide the integration (JSON import of recipes still works).
MORDORCOOK_URL=

# Look unknown barcodes up live on world.openfoodfacts.org (5 s timeout).
FOOD_OFF_LIVE=true

# Meal recognition from a photo. Only the plumbing exists so far — setting the
# flag changes nothing until a recognizer is implemented in recognition/.
FOOD_AI_ENABLED=false
ANTHROPIC_API_KEY=
FOOD_AI_MODEL=claude-haiku-4-5
