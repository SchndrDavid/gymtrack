# Host port the app is published on
GYMTRACK_PORT=8101

# User the container runs as — must own ./data
GYMTRACK_UID=1000
GYMTRACK_GID=1000

# ─── Food ───────────────────────────────────────────────────────────────────
# MordorCook on the same server — the Recipes list in the Food tab shows its recipes.
MORDORCOOK_URL=http://100.108.145.60:8105

# openGym on the same server — "Export AI" adds that day's openGym workouts. Needs the local
# fork of openGym (SINGLE_USER=1, GET /api/export/day). Unset, GymTrack tries port 8115 on the
# host the browser reached it at.
OPENGYM_URL=http://100.108.145.60:8115

# Look unknown barcodes up live on world.openfoodfacts.org (5 s timeout).
FOOD_OFF_LIVE=true

# Meal recognition from a photo. Only the plumbing exists so far — setting the
# flag changes nothing until a recognizer is implemented in recognition/.
FOOD_AI_ENABLED=false
ANTHROPIC_API_KEY=
FOOD_AI_MODEL=claude-haiku-4-5
